# Copy to .env beside SKILL.md and fill in your ChatBI account locally.
# Server root URL; do not append /mcp/chatbi.
CHATBI_SERVER_URL=https://www.clawchatbi.com
#local example: https://localhost:5300
CHATBI_USERNAME=
CHATBI_PASSWORD=
# Use single quotes for values containing spaces or #, e.g. 'your password'.
# Values are read as data; shell expansion and ${...} interpolation are disabled.
